<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 目标框架：.NET 10（LTS，本机 VS2026 配套 SDK），Windows 桌面专用 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- 启用 Windows 窗体（WinForms） -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CZRWeighSystem</RootNamespace>
    <AssemblyName>CZRWeighSystem</AssemblyName>
    <!-- 显示名称（窗口标题、exe 文件属性、安装包均取此处）与版本号 -->
    <AssemblyTitle>精锐计量称重软件</AssemblyTitle>
    <Product>精锐计量称重软件</Product>
    <Version>1.0.0</Version>
    <!-- ProductVersion 只取纯版本号，不追加 git 提交哈希（窗口标题显示用） -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- 生成中文资源，保证界面中文正常 -->
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <!-- x64 进程：VLC 原生解码库（libvlc/win-x64）要求位次匹配 -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- 程序图标（用户提供的「精锐计量」徽标，由 jpg 转换，含 16~256 多尺寸帧）：
         exe 文件图标，供资源管理器、桌面快捷方式、卸载列表使用 -->
    <ApplicationIcon>UI\Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQLite 数据库驱动（单机版数据库，无需安装数据库服务） -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <!-- 显式升级 SQLitePCLRaw 原生库：2.1.6 内置 SQLite < 3.50.2 有高危漏洞
         CVE-2025-6965 / GHSA-2m69-gcr7-jv3q，覆盖 Microsoft.Data.Sqlite 的传递依赖 2.1.6 -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <!-- SQL Server 驱动（网络版数据库，对应 PRD F9-05） -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <!-- 串口驱动（.NET 9+ 桌面框架不再内置，需显式引用） -->
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <!-- 二维码生成（磅单模板二维码元素用，MIT 协议） -->
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <!-- 视频流解码播放（萤石/慧眼智巡平台 FLV、HLS、RTMP、RTSP 通用，LGPL-2.1） -->
    <PackageReference Include="LibVLCSharp" Version="3.10.1" />
    <!-- VLC 原生内核（自动复制到输出目录 libvlc\win-x64，MPL-2.0） -->
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- 允许测试项目访问 internal 成员（如渲染器颜色解析） -->
    <InternalsVisibleTo Include="CZRWeighSystem.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 界面图标（空/重车自卸车图，用户提供，已处理为透明背景 PNG）随程序集内嵌，免外部文件 -->
    <EmbeddedResource Include="UI\Resources\*.png" />
    <!-- 程序图标随程序集内嵌，供窗体标题栏/任务栏使用（与 exe 图标同一份 app.ico） -->
    <EmbeddedResource Include="UI\Resources\app.ico" />
  </ItemGroup>

</Project>
